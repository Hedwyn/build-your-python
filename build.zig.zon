.{
    .name = .byp,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0-dev.1941",
    .fingerprint = 0x1aea75df6c046e4e,
    .dependencies = .{
        .zlib = .{
            .url = "https://github.com/allyourcodebase/zlib/archive/refs/tags/1.3.2.tar.gz",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
        // Not `allyourcodebase/openssl` any more: that package ships
        // pre-generated x86_64-only assembly with no per-arch variants,
        // panicking on any genuine cross-CPU-arch build -- own build.zig,
        // built with assembly optimizations off (portable C only), wrapping
        // the real upstream OpenSSL release source (see
        // vendoring/openssl/build.zig's own doc comment for the full
        // rationale and how its source list was derived).
        .openssl = .{ .path = "vendoring/openssl" },
        .libffi = .{
            .url = "https://github.com/allyourcodebase/libffi/archive/refs/tags/v3.5.2.tar.gz",
            .hash = "libffi-3.5.2-QhHaJyYYAAA1JzdzpVppCdz543jMEJGazBWhRR_FMvRg",
        },
        // musl's own sources, for building the real ld-musl-<arch>.so.1 a
        // dynamically-musl-linked interpreter needs at runtime (build/musl.zig).
        // Lazy: only a musl target ever fetches it. Keep this version in step with
        // the musl Zig bundles -- they have to agree on the libc ABI the stub Zig
        // links against.
        .musl = .{
            .url = "https://musl.libc.org/releases/musl-1.2.5.tar.gz",
            .hash = "N-V-__8AAB0gNQAtOCaRIfjFXtrGNrdtTXq5QfQ4TsUCOCUO",
            .lazy = true,
        },
        // Not `allyourcodebase/sqlite3` directly: its build.zig uses `Build.args`,
        // an API this project's pinned Zig no longer has (removed upstream,
        // unrelated to the actual library-build logic -- see
        // vendoring/sqlite3/build.zig's own doc comment). Same amalgamation
        // source, our own minimal build.zig.
        .sqlite3 = .{ .path = "vendoring/sqlite3" },
        .bzip2 = .{
            .url = "https://github.com/allyourcodebase/bzip2/archive/refs/tags/1.0.8.tar.gz",
            .hash = "bzip2-1.0.8-m7CPz2QGAADdAt97rbHaz6ekIt864HgHs9rZ3fsYF5Fy",
        },
        // No `allyourcodebase` package exists for liblzma at all (see
        // vendored_libraries_plan.md) -- own build.zig, wrapping the real
        // upstream xz source (fetched from a git commit, not a release
        // tarball: see vendoring/lzma/build.zig's own doc comment on why
        // that distinction matters for this specific library).
        .lzma = .{ .path = "vendoring/lzma" },

        // CPython source, one entry per version this project curates --
        // `-Dcpython-version=<name>` (see build/cpython_source.zig) picks
        // which one actually gets fetched; the rest stay untouched thanks to
        // `.lazy = true`. Not restricted to this list: `zig fetch
        // --save=<name> <url-or-git-ref>` adds any CPython source (a fork,
        // an unreleased tag, a local patch set pushed somewhere reachable)
        // under a name of your choosing, right here, the same way these
        // three were added -- then `-Dcpython-version=<name>` selects it
        // exactly like a curated one. That command is Zig's own fetcher
        // (tarball or `git+https://`), so no system `git` is ever required.
        //
        // python.org's own release tarballs, not GitHub's `archive/refs/tags/`
        // endpoint: identical either way content-wise, but whichever URL is
        // used, get its hash with `zig fetch --save=<name> <url>` run from
        // *this* project (not `zig fetch <url>` alone, and not run from some
        // other project/scratch dir) -- confirmed empirically while adding
        // these three that only that in-project, name-bound fetch reproduces
        // the hash `zig build` itself later checks against; a bare `zig fetch
        // <url>` elsewhere reliably prints a different, non-matching one.
        .@"3.12.13" = .{
            .url = "https://www.python.org/ftp/python/3.12.13/Python-3.12.13.tgz",
            .hash = "N-V-__8AACKyDQZ8F7LvEgi9FxB7FywC42NT1iGgQG62Ipcv",
            .lazy = true,
        },
        .@"3.13.8" = .{
            .url = "https://www.python.org/ftp/python/3.13.8/Python-3.13.8.tgz",
            .hash = "N-V-__8AAA9-VAZeGNDngevYCwIGqBAp80E6fpDoll2MemTW",
            .lazy = true,
        },
        .@"3.11.13" = .{
            .url = "https://www.python.org/ftp/python/3.11.13/Python-3.11.13.tgz",
            .hash = "N-V-__8AAF_HzQWJigIy6Bq0VxllPr_xdgh3bwqAYQ9pF4Sq",
            .lazy = true,
        },
        // Not python.org for this one, unlike the other three: confirmed
        // empirically (two separate `zig build`-triggered fetches, same URL,
        // same Zig binary, genuine cold caches) that python.org's CDN served
        // this particular file as different bytes -- and therefore a
        // different Zig package hash -- per request, so no hash pinned
        // against it stayed valid for long. GitHub's tag archive is Zig's
        // own usual answer to exactly this (see zlib/libffi/bzip2 above);
        // confirmed stable across two `zig build`-triggered fetches the same
        // way. If a fresh build ever reports "hash mismatch" for this entry
        // again regardless, re-derive the hash the same way it was derived
        // here: per the note above (lines 61-68) `zig fetch`/`zig fetch
        // --save=`, even run from this exact project root, reliably prints a
        // hash *other* than the one `zig build` itself will then check
        // against -- so don't trust that output for this entry (or the three
        // above it) either. Instead read the real one off `zig build`'s own
        // "hash mismatch: ... but the fetched package has X" error (trigger
        // it once with any placeholder hash) and write X here.
        .@"3.14.2" = .{
            .url = "https://github.com/python/cpython/archive/refs/tags/v3.14.2.tar.gz",
            .hash = "N-V-__8AADsJzwYOaKToupbULq5xl4CPRGnALYvMF1mCSv60",
            .lazy = true,
        },
        // No 3.15.0 final tarball exists on python.org yet (as of this pin) -- only
        // pre-releases up through rc2. Tracking rc2 here since CPython release
        // candidates are feature/ABI-frozen (only bugfixes land before final); re-pin
        // to the real `Python-3.15.0.tgz` URL/hash once it ships.
        .@"3.15.0rc2" = .{
            .url = "https://www.python.org/ftp/python/3.15.0/Python-3.15.0rc2.tgz",
            .hash = "N-V-__8AANRqMQijW_j0XUr13pTDtnJiWxeSi5Wx8EHXHhgT",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
